{
  "openapi": "3.1.0",
  "info": {
    "title": "Palliative Care ESAS Symptom Agent API",
    "version": "3.0.1",
    "description": "Descriptive ESAS-r endpoint plus legacy generic evaluation. No medical decision automation."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service liveness",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters (not Prometheus text)",
        "responses": {
          "200": {
            "description": "Diagnostic counters"
          }
        }
      }
    },
    "/api/esas": {
      "post": {
        "summary": "Descriptive nine-symptom ESAS-r assessment",
        "description": "Core ratings 0-10. Missing is null; total computed only when complete. No patient identifiers accepted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scores"
                ],
                "additionalProperties": false,
                "properties": {
                  "scores": {
                    "type": "object",
                    "description": "Nine ESAS-r domain names; unknown keys rejected by runtime",
                    "additionalProperties": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 10
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated symptom profile"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic metric evaluation (not ESAS-r)",
        "responses": {
          "200": {
            "description": "Legacy dossier"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Offline mock supervisor query",
        "responses": {
          "200": {
            "description": "Placeholder response"
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Audit-chain access requires explicit token",
        "parameters": [
          {
            "in": "header",
            "name": "X-Audit-Token",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit chain"
          },
          "403": {
            "description": "Disabled or unauthorized"
          }
        }
      }
    }
  }
}
